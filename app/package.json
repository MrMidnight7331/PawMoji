{
  "name": "pawmoji",
  "version": "0.0.8",
  "description": "A charming kaomoji clipboard for effortlessly adding kawaii faces to your text",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "MrMidnight",
  "license": "MIT",
  "dependencies": {
    "sql.js": "^1.8.0"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "icon": "assets/pawmoji-icon",
    "appId": "mrmidnight.pawmoji.project",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "linux": {
      "target": ["AppImage"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }

}